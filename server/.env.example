# ============================================
# Creator Studio 后端环境变量模板
# 复制为 .env 并填入实际值
# ============================================

# 服务端口
PORT=3001

# DeepSeek API Key
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key

# YouTube Data API v3 Key
# 获取地址: https://console.cloud.google.com/ (启用 YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_api_key

# 完整采集（RSS + YouTube + B站）间隔（cron 表达式）
# ★ 别调太密：YouTube 一次 search.list = 100 单位配额，一轮最多 20 个关键词 ≈ 2000 单位，
#   每日默认配额只有 10000 单位（≈5 轮）。默认 6 小时一轮（每天 4 轮）已经贴着上限。
COLLECT_INTERVAL=0 */6 * * *

# 轻量采集（只跑 RSS + B站，不消耗 YouTube 配额）间隔（cron 表达式）
# 默认每小时第 5 分钟；若上一轮采集在 30 分钟内跑过会自动跳过，避免与完整轮重复。
# 设成空字符串或非法 cron 就会关掉这条定时任务。
LIGHT_COLLECT_INTERVAL=5 * * * *

# HTTP 代理（中国大陆访问 YouTube/Google 需要）
# 部署到 Render 时留空（Render 服务器在海外，不需要代理）
HTTP_PROXY=

# AI 每日调用上限（防止公网被刷爆 DeepSeek API Key）
# 正整数，不填或非法值默认 300；每天 0 点自动重置
AI_DAILY_LIMIT=300

# Supabase 云同步配置
# 获取地址: https://supabase.com/ 注册后创建项目
# 在 Settings > API 中获取 URL 和 anon key
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# 账号 token 的签名密钥（可选）
# 不填的话服务器会自动生成一份并保存到 server/data/auth-secret.txt；
# 手动改动它会让所有人已登录的 token 立刻失效（需要重新登录）
AUTH_SECRET=
