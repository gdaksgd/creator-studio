[Unit]
Description=Creator Studio (Express API + built frontend)
After=network.target

[Service]
Type=simple
User=creator
Group=creator
WorkingDirectory=/opt/creator-studio/server
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
LimitNOFILE=65535
# 日志走 journald：journalctl -u creator-studio -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
